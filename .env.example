# Copy to .env and fill in (never commit .env; it is gitignored).
# Generate at https://login.tailscale.com/admin/settings/keys
# A reusable key is simplest; an ephemeral key works too (state persists in
# the tdrive-ts-state volume, so the node reuses its identity on restart).
TS_AUTHKEY=
TDRIVE_PORT=8080
