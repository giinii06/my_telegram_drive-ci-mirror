{
  "schema_version": 16,
  "daemon_protocol_version": 6,
  "wire_magic": "TDX1",
  "encryption_magic": "TDE1",
  "encryption_chunk_log2": 16,
  "op_types": [
    "dcommit",
    "encfg",
    "f",
    "fcommit",
    "freplace",
    "harddel",
    "manifest",
    "meta",
    "mkdir",
    "move",
    "part",
    "relocate",
    "rename",
    "rmdir",
    "tomb",
    "trash",
    "untrash"
  ],
  "http_routes": [
    "/",
    "/api/cp",
    "/api/find",
    "/api/list",
    "/api/mkdir",
    "/api/mv",
    "/api/onboarding/cancel",
    "/api/onboarding/code",
    "/api/onboarding/drive",
    "/api/onboarding/drives",
    "/api/onboarding/login",
    "/api/onboarding/password",
    "/api/onboarding/setup",
    "/api/onboarding/status",
    "/api/proxy/status",
    "/api/proxy/transcode",
    "/api/rm",
    "/api/settings/proxy",
    "/api/settings/token",
    "/api/status",
    "/api/thumb",
    "/api/upload",
    "/api/upload/status",
    "/file",
    "/proxy-hls"
  ],
  "docker_uses_tailscale_network": true,
  "docker_disables_os_mount": true
}
